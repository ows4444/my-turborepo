{
  "folders": [
    {
      "name": "root",
      "path": "./",
    },
    {
      "name": "web",
      "path": "apps/web",
    },
    {
      "name": "api",
      "path": "apps/api",
    },
    {
      "name": "packages",
      "path": "packages",
    },
  ],
  "settings": {
    "js/ts.preferences.includePackageJsonAutoImports": "auto",
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "terminal.integrated.cwd": "${workspaceFolder}",
    "files.exclude": {
      "**/node_modules": true,
      "**/.turbo": true,
      "**/.next": true,
      "**/dist": true,
      "**/coverage": true,
      "**/.pnpm-store": true,
      "**/.git": true,
      "**/tsconfig.tsbuildinfo": true,
      "**/next-env.d.ts": true,
      "**/tsconfig.json": true,
      "**/tsconfig.build.json": true,
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.turbo": true,
      "**/.next": true,
      "**/dist": true,
      "**/coverage": true,
      "**/tsconfig.tsbuildinfo": true,
      "**/next-env.d.ts": true,
    },
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Run Apps",
        "cwd": "${workspaceFolder}",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["dev"],
        "console": "integratedTerminal",
      },
    ],
  },
}
