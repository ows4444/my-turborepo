{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate --config=packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=packages/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=packages/db/drizzle.config.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.7",
    "@types/node": "^22.19.3",
    "typescript": "5.9.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.4.1"
    }
  },
  "packageManager": "pnpm@11.0.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
